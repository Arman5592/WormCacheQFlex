            "args": [
                "-smp", "4",
                "-M", "virt",
                "-cpu", "max",
                "-m", "16G",
                "-boot", "menu=on",
                "-rtc", "clock=vm",
                "-drive", "file=QEMU_EFI.qcow2,format=qcow2,if=pflash,read-only=on",
