                "-drive", "if=virtio,file=root.qcow2,format=qcow2",
                "-netdev", "user,id=unet,hostfwd=tcp::2244-:22",
                "-device", "virtio-net-device,netdev=unet",
                "-net", "user",
                "-nographic",
                "-no-reboot",
                "-quantum", 
                "size=1024",
                "-plugin", "/home/xusine/paraflex/WormCache/target/debug/libworm_cache.so",
                "-loadvm", "base",
